{
  "name": "@education-togo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @education-togo/shared build && prisma generate",
    "build": "nest build",
    "predev": "pnpm --filter @education-togo/shared build && prisma generate",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "db:up": "node scripts/dev-postgres.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@education-togo/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.17.2",
    "dotenv": "^18.0.10",
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
